{
  "name": "palworld-management-tools",
  "productName": "Palworld Server Studio",
  "version": "0.3.3",
  "description": "现代化幻兽帕鲁服务器远程管理工具",
  "author": "Palworld Server Studio Contributors",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron . --dev",
    "start": "electron .",
    "check": "node scripts/check.js",
    "build:win": "electron-builder --win nsis",
    "build": "npm run check && npm run build:win"
  },
  "keywords": ["electron", "palworld", "rcon", "server-manager"],
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "ejs": "^3.1.10",
    "jquery": "^3.7.1"
  },
  "devDependencies": {
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.palworld.serverstudio",
    "productName": "Palworld Server Studio",
    "directories": {
      "output": "release/windows"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": ["nsis"],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
